{
  "name": "ephemeral-pages-action",
  "version": "1.0.0",
  "description": "Publish temporary HTML reports from same-repository pull requests to Ephemeral Pages.",
  "keywords": [
    "github-action",
    "html-report",
    "pull-request"
  ],
  "license": "MIT",
  "author": "Schalk Neethling",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schalkneethling/ephemeral-pages-action.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts --minify --source-map",
    "bundle:check": "pnpm build && git diff --exit-code -- dist/index.js dist/index.js.map dist/package.json dist/sourcemap-register.cjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --config oxlint.json src tests",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "quality": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm bundle:check"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vercel/ncc": "^0.44.1",
    "@vitest/coverage-v8": "^3.2.4",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.10.0"
}
